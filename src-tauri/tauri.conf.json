{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.parkerasnicar.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
  "windows": [
    {
      "label": "create-note",
      "title": "New Note",
      "width": 860,
      "height": 150,
      "decorations": false,
      "resizable": false,
      "center": true,
      "transparent": true,
      "shadow": false,
      "visible": true
    },
    {
      "label": "view-note",
      "title": "NOTE NAME",
      "width": 700,
      "height": 450,
      "decorations": true,
      "resizable": true,
      "center": true,
      "transparent": false,
      "shadow": true,
      "visible": false
    },
    {
      "label": "list-note",
      "title": "Notes",
      "width": 300,
      "height": 800,
      "decorations": true,
      "resizable": false,
      "transparent": false,
      "shadow": true,
      "visible": false
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}